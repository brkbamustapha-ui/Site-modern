# Public site URL — used for canonical links, sitemap.xml and Open Graph tags.
# Set this to the production domain before deploying.
NEXT_PUBLIC_SITE_URL="https://bms-agency.com"

# Where the contact form sends a valid enquiry: any URL that accepts a JSON
# POST (your own API route, Formspree, a CRM webhook). Leave it unset and the
# form hands the visitor a pre-filled WhatsApp / email message instead — which
# is what the static GitHub Pages build does.
# NEXT_PUBLIC_CONTACT_ENDPOINT="https://example.com/api/contact"

# ---- Static export only (GitHub Pages and similar file-only hosts) ----
# Both are set automatically by .github/workflows/deploy-pages.yml.
# STATIC_EXPORT="1"
# BASE_PATH="/Site-modern"
