# PostgreSQL connection string used by Prisma.
# Local example (see README for docker-compose setup):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/la_dolce_vita?schema=public"

# Passcode required to access /admin. Change this to something private.
ADMIN_PASSCODE="change-me-please"

# Random secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Public site URL, used for SEO metadata + Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
