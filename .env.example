# ---------------------------------------------------------------------------
# Database — Neon (PostgreSQL)
# ---------------------------------------------------------------------------
# The app runs on Cloudflare Workers via Neon's serverless driver, so use the
# POOLED connection string here (the one containing "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/la_dolce_vita?sslmode=require"

# Prisma migrations and the seed script connect over plain TCP, which needs the
# DIRECT (non-pooled) string. Only needed on your machine / in CI, never on the
# Worker. Drop the "-pooler" part of the host.
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/la_dolce_vita?sslmode=require"

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Passcode required at /admin/login. Use a long random value in production.
ADMIN_PASSCODE="change-me-please"

# Secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Inlined at BUILD time (NEXT_PUBLIC_*), so it must be set when the build runs,
# not as a Worker secret. Used for SEO metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
